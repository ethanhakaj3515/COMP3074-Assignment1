<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light">
        <item name="android:colorAccent">#2457A7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F5F7FA</item>
        <item name="android:navigationBarColor">#F5F7FA</item>
    </style>
    <style name="OutputRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#17243A</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
    </style>
</resources>
